---
const { product } = Astro.props;
const isBrand = product.brands ? true : false;
---

<div class="lg:w-1/4 md:w-1/2 p-4 w-full">
    <a href={`/pro/${product.slug}`} class="block relative h-48 rounded overflow-hidden">
        <img alt="ecommerce" class="object-cover object-center w-full h-full block" src={product.thumbnail}>
    </a>
    <div class="mt-4">
        <!-- { isBrand ? <h3 class="text-gray-500 text-xs tracking-widest title-font mb-1">Brand: {product.brands}</h3> : ''} -->
        { isBrand && <h3 class="text-gray-500 text-xs tracking-widest title-font mb-1">Brand: {product.brands}</h3>}

        <h2 class="text-gray-900 title-font text-lg font-medium">{product.name}</h2>
        {/* <p class="mt-1">$16.00</p> */}
    </div>
</div>